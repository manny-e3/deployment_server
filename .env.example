# Copy to .env in the repo root. Every app and the Prisma CLI read this one file.
NODE_ENV=development
LOG_LEVEL=info

# API
PORT=4000
APP_URL=http://localhost:5173
# Generate with: openssl rand -hex 32
JWT_SECRET=
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_TTL=7d

# Shared by API and worker
DATABASE_URL=mysql://portal:portal@localhost:3307/portal
REDIS_URL=redis://localhost:6379
# Generate with: openssl rand -hex 32. Back it up: losing it loses every saved secret.
ENCRYPTION_KEY=
SSH_READY_TIMEOUT_MS=20000
SENTRY_DSN=

# Worker
WORKER_CONCURRENCY=5
DEPLOY_TIMEOUT_MIN=30
PROJECT_DEPLOY_CONCURRENCY=3
LOG_RETENTION_DAYS=90

# Development only
SHADOW_DATABASE_URL=mysql://portal:portal@localhost:3307/portal_shadow
SEED_ADMIN_EMAIL=admin@portal.local
# At least 12 characters
SEED_ADMIN_PASSWORD=
